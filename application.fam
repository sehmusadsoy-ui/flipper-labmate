App(
    appid="labmate",
    name="LabMate",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="labmate_app",
    # Exclude host-only native tests: Momentum's default "*.c*" would
    # accidentally include tests/test_resource_policy.c.inc in the FAP linker.
    sources=["*.c"],
    requires=["gui"],
    stack_size=4 * 1024,
    order=20,
    fap_category="Tools",
    fap_author="sehma",
    fap_icon="labmate_10px.png",
    fap_version="1.6.1",
    fap_description="Portable GPIO and digital signal diagnostic tool for Flipper Zero.",
)

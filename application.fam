App(
    appid="labmate",
    name="LabMate Ultimate",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="labmate_app",
    # Exclude host-only native tests: Momentum's default "*.c*" would
    # accidentally include tests/test_resource_policy.c.inc in the FAP linker.
    sources=["src/*.c"],
    requires=["gui"],
    stack_size=4 * 1024,
    order=20,
    fap_category="Tools",
    fap_author="SauronLAB / Sehmus",
    fap_icon="labmate_10px.png",
    fap_version="2.0",
    fap_description="LabMate Ultimate v2.0DEV: 3.3V digital diagnostics and measurement dashboard.",
)
